 },
 {
  "id": "FAN-대수-U9-006",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 107,
  "num": "U9-006",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "∑의 성질",
  "fanType": 2,
  "stdType": "∑의 성질",
  "level": "중",
  "kind": "주관식",
  "body": "다항식 $P(x)=x^{2n-1}(x-2)$를 $x-4$로 나누었을 때의 나머지를 $a_n$이라 할 때, $\\sum_{k=1}^{n}a_k$를 $n$에 대한 식으로 나타내시오.",
  "choices": [],
  "answer": "$\\dfrac{8(16^n-1)}{15}$",
  "figure": null,
  "solution": "다항식 $P(x)=x^{2n-1}(x-2)$를 $x-4$로 나누었을 때의 나머지는 $P(4)$이므로\n$$P(4)=a_n=4^{2n-1}\\cdot2=\\dfrac12\\cdot16^n$$\n이다.\n따라서\n$$\\sum_{k=1}^{n}a_k=\\dfrac12\\sum_{k=1}^{n}16^k=\\dfrac12\\cdot\\dfrac{16(16^n-1)}{16-1}=\\dfrac{8(16^n-1)}{15}$$\n이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-007",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 108,
  "num": "U9-007",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "특정한 값이 반복되는 수열의 합",
  "fanType": 3,
  "stdType": "특정한 값이 반복되는 수열의 합",
  "level": "중",
  "kind": "주관식",
  "body": "자연수 $n$에 대하여 $n$을 $3$으로 나누었을 때의 나머지를 $a_n$이라 할 때, $\\sum_{n=1}^{1000}a_n$의 값을 구하시오.",
  "choices": [],
  "answer": "1000",
  "figure": null,
  "solution": "자연수 $k$에 대하여\n(ⅰ) $n=3k-2$인 경우\n$n=1,4,7,10,\\cdots$ 이므로 $3$으로 나누었을 때의 나머지는 $1$이다.\n(ⅱ) $n=3k-1$인 경우\n$n=2,5,8,11,\\cdots$ 이므로 $3$으로 나누었을 때의 나머지는 $2$이다.\n(ⅲ) $n=3k$인 경우\n$n=3,6,9,12,\\cdots$ 이므로 $3$으로 나누었을 때의 나머지는 $0$이다.\n따라서\n$$\\sum_{n=1}^{1000}a_n=a_1+a_2+a_3+\\cdots+a_{999}+a_{1000}$$\n$$=1+2+0+1+2+0+\\cdots+0+1$$\n$$=(1+2+0)\\cdot333+1=1000$$\n이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-008",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 108,
  "num": "U9-008",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "특정한 값이 반복되는 수열의 합",
  "fanType": 3,
  "stdType": "특정한 값이 반복되는 수열의 합",
  "level": "중",
  "kind": "주관식",
  "body": "자연수 $n$에 대하여 $n$을 $5$로 나누었을 때의 나머지를 $a_n$이라 할 때, $\\sum_{n=1}^{100}a_n$의 값을 구하시오.",
  "choices": [],
  "answer": "200",
  "figure": null,
  "solution": "자연수 $k$에 대하여\n(ⅰ) $n=5k-4$인 경우\n$n=1,6,11,16,\\cdots$ 이므로 $5$로 나누었을 때의 나머지는 $1$이다.\n(ⅱ) $n=5k-3$인 경우\n$n=2,7,12,17,\\cdots$ 이므로 $5$로 나누었을 때의 나머지는 $2$이다.\n(ⅲ) $n=5k-2$인 경우\n$n=3,8,13,18,\\cdots$ 이므로 $5$로 나누었을 때의 나머지는 $3$이다.\n(ⅳ) $n=5k-1$인 경우\n$n=4,9,14,19,\\cdots$ 이므로 $5$로 나누었을 때의 나머지는 $4$이다.\n(ⅴ) $n=5k$인 경우\n$n=5,10,15,20,\\cdots$ 이므로 $5$로 나누었을 때의 나머지는 $0$이다.\n따라서\n$$\\sum_{n=1}^{100}a_n=a_1+a_2+a_3+\\cdots+a_{99}+a_{100}$$\n$$=1+2+3+4+0+1+2+\\cdots+4+0$$\n$$=(1+2+3+4)\\cdot20=200$$\n이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-009",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 108,
  "num": "U9-009",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "특정한 값이 반복되는 수열의 합",
  "fanType": 3,
  "stdType": "특정한 값이 반복되는 수열의 합",
  "level": "중",
  "kind": "주관식",
  "body": "$x_1$, $x_2$, $x_3$, $\\cdots$, $x_n$ 는 $0$, $1$, $2$ 중 어느 하나의 값을 갖는다. $\\sum_{i=1}^{n}x_i=16$, $\\sum_{i=1}^{n}x_i^2=28$일 때, $\\sum_{i=1}^{n}x_i^5$의 값을 구하시오.",
  "choices": [],
  "answer": "196",
  "figure": null,
  "solution": "$x_1$, $x_2$, $x_3$, $\\cdots$, $x_n$ 중 $1$이 $a$개, $2$가 $b$개 있다고 하면 $\\sum_{i=1}^{n}x_i=1\\cdot a+2\\cdot b=16$ 이므로\n$a+2b=16$이고 $\\sum_{i=1}^{n}x_i^2=1^2\\cdot a+2^2\\cdot b=28$ 이므로\n$a+4b=28$ 이다.\n따라서 두 식을 연립하면 $a=4$, $b=6$ 이고\n$$\\sum_{i=1}^{n}x_i^5=1^5\\cdot4+2^5\\cdot6=196$$\n이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-010",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 109,
  "num": "U9-010",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "∑와 등차수열, 등비수열",
  "fanType": 4,
  "stdType": "∑와 등차수열, 등비수열",
  "level": "중",
  "kind": "주관식",
  "body": "$\\sum_{k=1}^{5}\\dfrac{4^k-3^k}{2^k}=a\\cdot2^5+b\\left(\\dfrac32\\right)^5+c$ 를 만족시키는 정수 $a,\\,b,\\,c$ 에 대하여 $a+b+c$ 의 값을 구하시오.",
  "choices": [],
  "answer": "0",
  "figure": null,
  "solution": "$\\sum_{k=1}^{5}\\dfrac{4^k-3^k}{2^k}$을 정리하면 $\\sum_{k=1}^{5}2^k-\\sum_{k=1}^{5}\\left(\\dfrac32\\right)^k$이다.\n$\\sum_{k=1}^{5}2^k$은 초항이 $2$이고 공비가 $2$인 등비수열의 제$1$항부터 제$5$항까지의 합이므로\n$$\\sum_{k=1}^{5}2^k=\\dfrac{2(2^5-1)}{2-1}=2\\cdot2^5-2$$\n이고\n$\\sum_{k=1}^{5}\\left(\\dfrac32\\right)^k$은 초항이 $\\dfrac32$이고 공비가 $\\dfrac32$인 등비수열의 제$1$항부터 제$5$항까지의 합이므로\n$$\\sum_{k=1}^{5}\\left(\\dfrac32\\right)^k=\\dfrac{\\dfrac32\\left\\{\\left(\\dfrac32\\right)^5-1\\right\\}}{\\dfrac32-1}=3\\left(\\dfrac32\\right)^5-3$$\n이다.\n따라서 $\\sum_{k=1}^{5}\\dfrac{4^k-3^k}{2^k}=2\\cdot2^5-3\\left(\\dfrac32\\right)^5+1$이고\n$a=2$, $b=-3$, $c=1$이므로 $a+b+c=0$ 이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-011",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 109,
  "num": "U9-011",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "∑와 등차수열, 등비수열",
  "fanType": 4,
  "stdType": "∑와 등차수열, 등비수열",
  "level": "중",
  "kind": "주관식",
  "body": "$\\sum_{k=1}^{5}\\dfrac{2^k-5^k}{3^k}=a\\cdot\\left(\\dfrac23\\right)^5+b\\left(\\dfrac53\\right)^5+c$ 를 만족시키는 실수 $a,\\,b,\\,c$ 에 대하여 $a+b+c$ 의 값을 구하시오.",
  "choices": [],
  "answer": "0",
  "figure": null,
  "solution": "$\\sum_{k=1}^{5}\\dfrac{2^k-5^k}{3^k}$을 정리하면 $\\sum_{k=1}^{5}\\left(\\dfrac23\\right)^k-\\sum_{k=1}^{5}\\left(\\dfrac53\\right)^k$이다.\n$\\sum_{k=1}^{5}\\left(\\dfrac23\\right)^k$은 초항이 $\\dfrac23$이고 공비가 $\\dfrac23$인 등비수열의 제$1$항부터 제$5$항까지의 합이므로\n$$\\sum_{k=1}^{5}\\left(\\dfrac23\\right)^k=\\dfrac{\\dfrac23\\left\\{1-\\left(\\dfrac23\\right)^5\\right\\}}{1-\\dfrac23}=2-2\\cdot\\left(\\dfrac23\\right)^5$$\n이고\n$\\sum_{k=1}^{5}\\left(\\dfrac53\\right)^k$은 초항이 $\\dfrac53$이고 공비가 $\\dfrac53$인 등비수열의 제$1$항부터 제$5$항까지의 합이므로\n$$\\sum_{k=1}^{5}\\left(\\dfrac53\\right)^k=\\dfrac{\\dfrac53\\left\\{\\left(\\dfrac53\\right)^5-1\\right\\}}{\\dfrac53-1}=\\dfrac52\\left(\\dfrac53\\right)^5-\\dfrac52$$\n이다.\n따라서 $\\sum_{k=1}^{5}\\dfrac{2^k-5^k}{3^k}=-2\\cdot\\left(\\dfrac23\\right)^5-\\dfrac52\\left(\\dfrac53\\right)^5+\\dfrac92$\n이고 $a=-2$, $b=-\\dfrac52$, $c=\\dfrac92$이므로\n$a+b+c=0$ 이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-012",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 109,
  "num": "U9-012",
  "unit": "대수-3-09",
  "unitName": "수열 › 수열의 합",
  "type": "∑와 등차수열, 등비수열",
  "fanType": 4,
  "stdType": "∑와 등차수열, 등비수열",
  "level": "중",
  "kind": "주관식",
  "body": "$\\sum_{k=1}^{n}a_k=5n$, $\\sum_{k=1}^{n}b_k=-2n^2$일 때, $\\sum_{k=1}^{10}(2a_k-b_k+5)$의 값을 구하시오.",
  "choices": [],
  "answer": "350",
  "figure": null,
  "solution": "$\\sum_{k=1}^{n}a_k=5n$, $\\sum_{k=1}^{n}b_k=-2n^2$에 $n=10$을 각각 대입하면\n$$\\sum_{k=1}^{10}a_k=5\\cdot10=50,\\qquad \\sum_{k=1}^{10}b_k=-2\\cdot10^2=-200$$\n$$\\therefore\\ \\sum_{k=1}^{10}(2a_k-b_k+5)=2\\sum_{k=1}^{10}a_k-\\sum_{k=1}^{10}b_k+\\sum_{k=1}^{10}5$$\n$$=2\\cdot50-(-200)+5\\cdot10=350$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U9-013",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 110,
  "num": "U9-013",
