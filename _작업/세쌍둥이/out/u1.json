  "level": "중",
  "kind": "주관식",
  "body": "$(a-b-2c)(a-b+2c)$를 전개하시오.",
  "choices": [],
  "answer": "$a^2-2ab+b^2-4c^2$",
  "figure": null,
  "solution": "$a-b=k$로 놓으면\n$$\\begin{aligned}(\\text{주어진 식})&=(k-2c)(k+2c)=k^2-4c^2\\\\&=(a-b)^2-4c^2\\\\&=a^2-2ab+b^2-4c^2\\end{aligned}$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-공수1-U1-011",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 공통수학1",
  "page": 5,
  "num": "U1-011",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
