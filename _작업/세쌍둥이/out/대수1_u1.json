 {
  "id": "FAN-대수-U1-004",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 3,
  "num": "U1-004",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "문자를 포함한 거듭제곱근의 계산",
  "fanType": 2,
  "stdType": "문자를 포함한 거듭제곱근의 계산",
  "level": "중",
  "kind": "주관식",
  "body": "$x>0$일 때, $\\sqrt[4]{\\dfrac{\\sqrt[3]{x}}{\\sqrt[4]{x}}}\\times\\sqrt[3]{\\dfrac{\\sqrt{x}}{\\sqrt[4]{x}}}\\times\\sqrt{\\dfrac{\\sqrt{x}}{\\sqrt[3]{x}}}$를 간단히 하시오.",
  "choices": [],
  "answer": "$\\sqrt[16]{x^3}$",
  "figure": null,
  "solution": "$$\\sqrt[4]{\\frac{\\sqrt[3]{x}}{\\sqrt[4]{x}}}\\times\\sqrt[3]{\\frac{\\sqrt{x}}{\\sqrt[4]{x}}}\\times\\sqrt{\\frac{\\sqrt{x}}{\\sqrt[3]{x}}}=\\frac{\\sqrt[12]{x}}{\\sqrt[16]{x}}\\times\\frac{\\sqrt[6]{x}}{\\sqrt[12]{x}}\\times\\frac{\\sqrt[4]{x}}{\\sqrt[6]{x}}=\\frac{\\sqrt[4]{x}}{\\sqrt[16]{x}}$$\n$$=\\frac{x^{\\frac14}}{x^{\\frac1{16}}}=x^{\\frac4{16}-\\frac1{16}}=\\sqrt[16]{x^3}$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-005",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 3,
  "num": "U1-005",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "문자를 포함한 거듭제곱근의 계산",
  "fanType": 2,
  "stdType": "문자를 포함한 거듭제곱근의 계산",
  "level": "중",
  "kind": "주관식",
  "body": "$x>0$일 때, $\\sqrt[5]{\\dfrac{\\sqrt{x}}{\\sqrt[3]{x}}}\\times\\sqrt{\\dfrac{\\sqrt[4]{x}}{\\sqrt[3]{x}}}\\times\\sqrt{\\dfrac{\\sqrt[3]{x}}{\\sqrt{x}}}$를 간단히 하시오.",
  "choices": [],
  "answer": "$x^{-\\frac{11}{120}}$",
  "figure": null,
  "solution": "$$\\sqrt[5]{\\frac{\\sqrt{x}}{\\sqrt[3]{x}}}\\times\\sqrt{\\frac{\\sqrt[4]{x}}{\\sqrt[3]{x}}}\\times\\sqrt{\\frac{\\sqrt[3]{x}}{\\sqrt{x}}}=\\frac{\\sqrt[10]{x}}{\\sqrt[15]{x}}\\times\\frac{\\sqrt[8]{x}}{\\sqrt[6]{x}}\\times\\frac{\\sqrt[6]{x}}{\\sqrt[4]{x}}=\\frac{\\sqrt[10]{x}}{\\sqrt[15]{x}}\\times\\frac{\\sqrt[8]{x}}{\\sqrt[4]{x}}$$\n$$=x^{\\frac1{10}+\\frac18-\\frac1{15}-\\frac14}=x^{\\frac{12}{120}+\\frac{15}{120}-\\frac{8}{120}-\\frac{30}{120}}=x^{-\\frac{11}{120}}$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-006",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 3,
  "num": "U1-006",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "문자를 포함한 거듭제곱근의 계산",
  "fanType": 2,
  "stdType": "문자를 포함한 거듭제곱근의 계산",
  "level": "중",
  "kind": "주관식",
  "body": "$a>0$일 때, $\\dfrac{\\sqrt{a\\sqrt[3]{a\\sqrt[4]{a}}}}{\\sqrt[4]{a\\sqrt[3]{a\\sqrt{a}}}}=\\sqrt[n]{a^m}$을 만족시키는 서로소인 두 자연수 $m$, $n$에 대하여 $m+n$의 값을 구하시오.",
  "choices": [],
  "answer": "4",
  "figure": null,
  "solution": "$$\\frac{\\sqrt{a\\sqrt[3]{a\\sqrt[4]{a}}}}{\\sqrt[4]{a\\sqrt[3]{a\\sqrt{a}}}}=\\frac{\\sqrt{a}\\times\\sqrt[6]{a}\\times\\sqrt[24]{a}}{\\sqrt[4]{a}\\times\\sqrt[12]{a}\\times\\sqrt[24]{a}}=\\frac{\\sqrt[24]{a^{12}\\times a^4\\times a}}{\\sqrt[24]{a^6\\times a^2\\times a}}$$\n$$=\\sqrt[24]{\\frac{a^{17}}{a^9}}=\\sqrt[24]{a^8}=\\sqrt[3]{a}$$\n따라서 $m=1$, $n=3$이고 $m+n=4$ 이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-007",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 4,
  "num": "U1-007",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "거듭제곱근의 대소 비교",
  "fanType": 3,
  "stdType": "거듭제곱근의 대소 비교",
  "level": "중",
  "kind": "주관식",
  "body": "세 수 $\\sqrt{2}$, $\\sqrt[3]{3}$, $\\sqrt[4]{5}$의 대소 관계를 구하시오.",
  "choices": [],
  "answer": "$\\sqrt{2}<\\sqrt[3]{3}<\\sqrt[4]{5}$",
  "figure": null,
  "solution": "$\\sqrt{2}=2^{\\frac12}$, $\\sqrt[3]{3}=3^{\\frac13}$, $\\sqrt[4]{5}=5^{\\frac14}$ 에서\n$2$, $3$, $4$의 최소공배수가 $12$이므로\n$\\sqrt{2}=\\sqrt[12]{2^6}=\\sqrt[12]{64}$, $\\sqrt[3]{3}=\\sqrt[12]{3^4}=\\sqrt[12]{81}$,\n$\\sqrt[4]{5}=\\sqrt[12]{5^3}=\\sqrt[12]{125}$ 이다.\n이때, $64<81<125$ 이므로\n$\\sqrt[12]{64}<\\sqrt[12]{81}<\\sqrt[12]{125}$ 이고\n$\\sqrt{2}<\\sqrt[3]{3}<\\sqrt[4]{5}$ 이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-008",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 4,
  "num": "U1-008",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "거듭제곱근의 대소 비교",
  "fanType": 3,
  "stdType": "거듭제곱근의 대소 비교",
  "level": "중",
  "kind": "주관식",
  "body": "세 수 $\\sqrt{2}$, $\\sqrt[4]{3}$, $\\sqrt[5]{5}$의 대소 관계를 구하시오.",
  "choices": [],
  "answer": "$\\sqrt[4]{3}<\\sqrt[5]{5}<\\sqrt{2}$",
  "figure": null,
  "solution": "$\\sqrt{2}=2^{\\frac12}$, $\\sqrt[4]{3}=3^{\\frac14}$, $\\sqrt[5]{5}=5^{\\frac15}$ 에서\n$2$, $4$, $5$의 최소공배수가 $20$이므로\n$\\sqrt{2}=\\sqrt[20]{2^{10}}=\\sqrt[20]{1024}$, $\\sqrt[4]{3}=\\sqrt[20]{3^5}=\\sqrt[12]{243}$,\n$\\sqrt[5]{5}=\\sqrt[20]{5^4}=\\sqrt[12]{625}$ 이다.\n이때, $64<81<125$ 이므로\n$\\sqrt[20]{243}<\\sqrt[20]{625}<\\sqrt[20]{1024}$ 이고\n$\\sqrt[4]{3}<\\sqrt[5]{5}<\\sqrt{2}$ 이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-009",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 4,
  "num": "U1-009",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "거듭제곱근의 대소 비교",
  "fanType": 3,
  "stdType": "거듭제곱근의 대소 비교",
  "level": "중",
  "kind": "주관식",
  "body": "세 수 $\\sqrt{2\\sqrt[3]{2}}$, $\\sqrt{9\\sqrt[3]{3}}$, $\\sqrt{5\\sqrt[3]{5}}$ 중에서 가장 작은 수를 $a$, 두 번째로 큰 수를 $b$라 할 때, 부등식 $a<\\sqrt[6]{n}<b$를 만족시키는 자연수 $n$의 개수를 구하시오.",
  "choices": [],
  "answer": "608개",
  "figure": null,
  "solution": "$\\sqrt{2\\sqrt[3]{2}}=\\sqrt{\\sqrt[3]{2^3\\times2}}=\\sqrt[6]{16}$,\n$\\sqrt{9\\sqrt[3]{3}}=\\sqrt{\\sqrt[3]{9^3\\times3}}=\\sqrt[6]{2187}$,\n$\\sqrt{5\\sqrt[3]{5}}=\\sqrt{\\sqrt[3]{5^3\\times5}}=\\sqrt[6]{625}$이므로 대소 관계는\n$\\sqrt[6]{16}<\\sqrt[6]{625}<\\sqrt[6]{2187}$ 이다.\n따라서 $a=\\sqrt[6]{16}$, $b=\\sqrt[6]{625}$ 이므로\n부등식 $\\sqrt[6]{16}<\\sqrt[6]{n}<\\sqrt[6]{625}$를 만족시키는 자연수\n$n$은 $17$, $18$, $19$, $\\cdots$, $624$의 $608$개다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-010",
