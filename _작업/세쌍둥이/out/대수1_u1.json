  "stdType": "지수가 실수인 식의 계산",
  "level": "중",
  "kind": "주관식",
  "body": "$\\left\\{\\left(\\dfrac{27}{125}\\right)^{\\frac59}\\right\\}^{\\frac35}\\times\\left\\{\\left(\\dfrac13\\right)^{-\\frac52}\\right\\}^{\\frac45}$의 값을 구하시오.",
  "choices": [],
  "answer": "$\\dfrac{27}{5}$",
  "figure": null,
  "solution": "$$\\left\\{\\left(\\frac{27}{125}\\right)^{\\frac59}\\right\\}^{\\frac35}\\times\\left\\{\\left(\\frac13\\right)^{-\\frac52}\\right\\}^{\\frac45}=\\left(\\frac{27}{125}\\right)^{\\frac59\\times\\frac35}\\times\\left(\\frac13\\right)^{-\\frac52\\times\\frac45}$$\n$$=\\left(\\frac{27}{125}\\right)^{\\frac13}\\times\\left(\\frac13\\right)^{-2}=\\left\\{\\left(\\frac35\\right)^3\\right\\}^{\\frac13}\\times(3^{-1})^{-2}=\\frac35\\times3^2=\\frac{27}{5}$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-011",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 5,
  "num": "U1-011",
  "unit": "대수-1-01",
  "unitName": "지수함수와 로그함수 › 지수",
  "type": "지수가 실수인 식의 계산",
  "fanType": 4,
  "stdType": "지수가 실수인 식의 계산",
  "level": "중",
  "kind": "주관식",
  "body": "$\\left\\{\\left(\\dfrac{9}{16}\\right)^{\\frac25}\\right\\}^{\\frac54}\\times\\left\\{\\left(\\dfrac12\\right)^{-\\frac53}\\right\\}^{\\frac65}$의 값을 구하시오.",
  "choices": [],
  "answer": "3",
  "figure": null,
  "solution": "$$\\left\\{\\left(\\frac{9}{16}\\right)^{\\frac25}\\right\\}^{\\frac54}\\times\\left\\{\\left(\\frac12\\right)^{-\\frac53}\\right\\}^{\\frac65}=\\left(\\frac{9}{16}\\right)^{\\frac25\\times\\frac54}\\times\\left(\\frac12\\right)^{-\\frac53\\times\\frac65}$$\n$$=\\left(\\frac{9}{16}\\right)^{\\frac12}\\times\\left(\\frac12\\right)^{-2}=\\left\\{\\left(\\frac34\\right)^2\\right\\}^{\\frac12}\\times(2^{-1})^{-2}=\\frac34\\times2^2=3$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "FAN-대수-U1-012",
  "source": "학원교재",
  "book": "세쌍둥이 유형편 대수",
  "page": 5,
  "num": "U1-012",
