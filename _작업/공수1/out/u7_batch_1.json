  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$2\\le x\\le 4$일 때, 식 $x-2$의 값의 범위를 구하시오.",
  "choices": [],
  "answer": "$0\\le x-2\\le 2$",
  "figure": null,
  "solution": "$2\\le x\\le 4$의 각 변에서 $2$를 빼면\n$$0\\le x-2\\le 2$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0782",
