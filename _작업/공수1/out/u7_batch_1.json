  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$b<0<a$일 때, 두 수 $ab$, $b^2$의 대소를 비교하시오.",
  "choices": [],
  "answer": "$ab<b^2$",
  "figure": null,
  "solution": "$b<0$이므로 $a>b$의 양변에 $b$를 곱하면\n$$ab<b^2$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0779",
  "source": "시중교재",
