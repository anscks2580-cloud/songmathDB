  "type": "부등식의 기본 성질",
  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$b<0<a$일 때, 두 수 $a+b$, $2a$의 대소를 비교하시오.",
  "choices": [],
  "answer": "$a+b<2a$",
  "figure": null,
  "solution": "$b<a$의 양변에 $a$를 더하면\n$$b+a<a+a \\quad\\therefore\\ a+b<2a$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0778",
