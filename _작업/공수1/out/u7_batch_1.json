  "unitName": "부등식 › 일차부등식",
  "type": "부등식의 기본 성질",
  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$b<0<a$일 때, 두 수 $3a+1$, $3b+1$의 대소를 비교하시오.",
  "choices": [],
  "answer": "$3a+1>3b+1$",
  "figure": null,
  "solution": "$a>b$의 양변에 $3$을 곱하면\n$$3a>3b$$\n이 식의 양변에 $1$을 더하면\n$$3a+1>3b+1$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0780",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
