  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "일차부등식 $0.2x>0.42-0.01x$를 푸시오.",
  "choices": [],
  "answer": "$x>2$",
  "figure": null,
  "solution": "$0.2x>0.42-0.01x$의 양변에 $100$을 곱하면\n$$20x>42-x,\\qquad 21x>42$$\n$$\\therefore\\ x>2$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0789",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0789",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식 ax>b의 풀이",
  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "부등식 $ax<a+2$를 푸시오. (단, $a$는 실수이다.)",
  "choices": [],
  "answer": "풀이 참조",
  "figure": null,
  "solution": "$ax<a+2$에서\n(i) $a>0$일 때, $x<\\dfrac{a+2}{a}$\n(ii) $a<0$일 때, $x>\\dfrac{a+2}{a}$\n(iii) $a=0$일 때, $0\\cdot x<2$이므로 해는 모든 실수이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0790",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0790",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식 ax>b의 풀이",
  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "부등식 $(a-1)x>a$를 푸시오. (단, $a$는 실수이다.)",
  "choices": [],
  "answer": "풀이 참조",
  "figure": null,
  "solution": "$(a-1)x>a$에서\n(i) $a>1$일 때, $x>\\dfrac{a}{a-1}$\n(ii) $a<1$일 때, $x<\\dfrac{a}{a-1}$\n(iii) $a=1$일 때, $0\\cdot x>1$이므로 해는 없다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0791",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0791",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식 ax>b의 풀이",
  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "부등식 $ax+1\\ge a^2-x$를 푸시오. (단, $a$는 실수이다.)",
  "choices": [],
  "answer": "풀이 참조",
  "figure": null,
  "solution": "$ax+1\\ge a^2-x$에서 $(a+1)x\\ge a^2-1$\n$$(a+1)x\\ge (a+1)(a-1)$$\n(i) $a>-1$일 때, $x\\ge a-1$\n(ii) $a<-1$일 때, $x\\le a-1$\n(iii) $a=-1$일 때, $0\\cdot x\\ge 0$이므로 해는 모든 실수이다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0792",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0792",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "연립일차부등식",
  "stdType": "연립일차부등식",
  "level": "하",
  "kind": "주관식",
  "body": "연립부등식 $\\begin{cases} x+1<6 \\\\ 5x-2<2x-8 \\end{cases}$을 푸시오.",
  "choices": [],
  "answer": "$x<-2$",
  "figure": null,
  "solution": "$x+1<6$에서 $x<5$ ⋯⋯ ㉠\n$5x-2<2x-8$에서 $3x<-6$\n$$\\therefore\\ x<-2 \\quad ⋯⋯ ㉡$$\n㉠, ㉡의 공통부분을 구하면\n$$x<-2$$\n(해설 그림 생략)",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0793",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0793",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "연립일차부등식",
  "stdType": "연립일차부등식",
  "level": "하",
  "kind": "주관식",
  "body": "연립부등식 $\\begin{cases} 2x+3<9 \\\\ 4x+1\\ge x-2 \\end{cases}$를 푸시오.",
  "choices": [],
  "answer": "$-1\\le x<3$",
  "figure": null,
  "solution": "$2x+3<9$에서 $2x<6$\n$$\\therefore\\ x<3 \\quad ⋯⋯ ㉠$$\n$4x+1\\ge x-2$에서 $3x\\ge -3$\n$$\\therefore\\ x\\ge -1 \\quad ⋯⋯ ㉡$$\n㉠, ㉡의 공통부분을 구하면\n$$-1\\le x<3$$\n(해설 그림 생략)",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0794",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0794",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "연립일차부등식",
  "stdType": "연립일차부등식",
  "level": "하",
  "kind": "주관식",
  "body": "연립부등식 $\\begin{cases} 5x+6>x+4 \\\\ x+5\\le 3(x-1) \\end{cases}$을 푸시오.",
  "choices": [],
  "answer": "$x\\ge 4$",
  "figure": null,
  "solution": "$5x+6>x+4$에서 $4x>-2$\n$$\\therefore\\ x>-\\dfrac12 \\quad ⋯⋯ ㉠$$\n$x+5\\le 3(x-1)$에서 $x+5\\le 3x-3$\n$$-2x\\le -8 \\quad\\therefore\\ x\\ge 4 \\quad ⋯⋯ ㉡$$\n㉠, ㉡의 공통부분을 구하면\n$$x\\ge 4$$\n(해설 그림 생략)",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0795",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0795",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "연립일차부등식",
  "stdType": "연립일차부등식",
  "level": "하",
  "kind": "주관식",
  "body": "연립부등식 $\\begin{cases} 0.9x+1.3<-5 \\\\ \\dfrac{5}{12}x-1\\ge x+\\dfrac16 \\end{cases}$을 푸시오.",
  "choices": [],
  "answer": "$x<-7$",
  "figure": null,
  "solution": "$0.9x+1.3<-5$의 양변에 $10$을 곱하면\n$$9x+13<-50,\\qquad 9x<-63$$\n$$\\therefore\\ x<-7 \\quad ⋯⋯ ㉠$$\n$\\dfrac{5}{12}x-1\\ge x+\\dfrac16$의 양변에 $12$를 곱하면\n$$5x-12\\ge 12x+2,\\qquad -7x\\ge 14$$\n$$\\therefore\\ x\\le -2 \\quad ⋯⋯ ㉡$$\n㉠, ㉡의 공통부분을 구하면\n$$x<-7$$\n(해설 그림 생략)",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0796",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0796",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "연립일차부등식",
  "stdType": "연립일차부등식",
  "level": "하",
  "kind": "주관식",
  "body": "연립부등식 $\\begin{cases} \\dfrac13x-2<\\dfrac12 \\\\ 1.3x-3.6>0.7x \\end{cases}$을 푸시오.",
  "choices": [],
  "answer": "$6<x<\\dfrac{15}{2}$",
  "figure": null,
  "solution": "$\\dfrac13x-2<\\dfrac12$의 양변에 $6$을 곱하면\n$$2x-12<3,\\qquad 2x<15$$\n$$\\therefore\\ x<\\dfrac{15}{2} \\quad ⋯⋯ ㉠$$\n$1.3x-3.6>0.7x$의 양변에 $10$을 곱하면\n$$13x-36>7x,\\qquad 6x>36$$\n$$\\therefore\\ x>6 \\quad ⋯⋯ ㉡$$\n㉠, ㉡의 공통부분을 구하면\n$$6<x<\\dfrac{15}{2}$$\n(해설 그림 생략)",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0797",
