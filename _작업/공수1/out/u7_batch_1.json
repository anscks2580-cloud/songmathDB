  "num": "0780",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식의 기본 성질",
  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$b<0<a$일 때, 두 수 $-\\dfrac12a+5$, $-\\dfrac12b+5$의 대소를 비교하시오.",
  "choices": [],
  "answer": "$-\\dfrac12a+5<-\\dfrac12b+5$",
  "figure": null,
  "solution": "$a>b$의 양변에 $-\\dfrac12$을 곱하면\n$$-\\dfrac12a<-\\dfrac12b$$\n이 식의 양변에 $5$를 더하면\n$$-\\dfrac12a+5<-\\dfrac12b+5$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0781",
  "source": "시중교재",
