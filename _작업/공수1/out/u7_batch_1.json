 },
 {
  "id": "SSEN-공수1-0784",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0784",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식의 기본 성질",
  "stdType": "부등식의 기본 성질",
  "level": "하",
  "kind": "주관식",
  "body": "$2\\le x\\le 4$일 때, 식 $\\dfrac1x$의 값의 범위를 구하시오.",
  "choices": [],
  "answer": "$\\dfrac14\\le \\dfrac1x\\le \\dfrac12$",
  "figure": null,
  "solution": "$2\\le x\\le 4$의 각 변의 역수를 취하면\n$$\\dfrac14\\le \\dfrac1x\\le \\dfrac12$$\n\n**SSEN 특강** $0<a\\le x\\le b$ 또는 $a\\le x\\le b<0$일 때, $x$의 역수 $\\dfrac1x$의 값의 범위는 다음과 같다.\n(i) $ax>0$이므로 $a\\le x$의 양변을 $ax$로 나누면\n$$\\dfrac1x\\le \\dfrac1a$$\n(ii) $bx>0$이므로 $x\\le b$의 양변을 $bx$로 나누면\n$$\\dfrac1b\\le \\dfrac1x$$\n(i), (ii)에서 $\\dfrac1b\\le \\dfrac1x\\le \\dfrac1a$\n➡ $a$와 $b$의 부호가 같으면 $a\\le x\\le b$일 때 $\\dfrac1b\\le \\dfrac1x\\le \\dfrac1a$임을 알 수 있다.",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0785",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0785",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식 ax>b의 풀이",
  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "일차부등식 $7x-8\\ge 10x+4$를 푸시오.",
  "choices": [],
  "answer": "$x\\le -4$",
  "figure": null,
  "solution": "$7x-8\\ge 10x+4$에서 $-3x\\ge 12$\n$$\\therefore\\ x\\le -4$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0786",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 117,
  "num": "0786",
  "unit": "공수1-3-07",
  "unitName": "부등식 › 일차부등식",
  "type": "부등식 ax>b의 풀이",
  "stdType": "부등식 ax>b의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "일차부등식 $5(x-2)<3x+2$를 푸시오.",
  "choices": [],
  "answer": "$x<6$",
  "figure": null,
  "solution": "$5(x-2)<3x+2$에서 $5x-10<3x+2$\n$$2x<12 \\quad\\therefore\\ x<6$$",
  "parent": "",
  "variant": ""
 },
 {
  "id": "SSEN-공수1-0787",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
