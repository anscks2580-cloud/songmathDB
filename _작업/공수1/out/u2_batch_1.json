[
 {
  "id": "SSEN-공수1-0115",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 25,
  "num": "0115",
  "unit": "공수1-1-02",
  "unitName": "다항식 › 나머지정리와 인수분해",
  "type": "항등식",
  "level": "하",
  "kind": "주관식",
  "body": "$x$에 대한 항등식인 것만을 보기에서 있는 대로 고르시오.\n> ㄱ. $x^2-x=0$\n> ㄴ. $3x+1=2x-1$\n> ㄷ. $x^2-4x+5=x(x-4)+5$\n> ㄹ. $(x+1)^2-(x+1)=x^2+x$",
  "choices": [],
  "answer": "ㄷ, ㄹ",
  "figure": null,
  "solution": "ㄷ. (우변)$=x(x-4)+5=x^2-4x+5=$(좌변)\nㄹ. (좌변)$=(x+1)^2-(x+1)=x^2+2x+1-(x+1)$\n$=x^2+x=$(우변)\n이상에서 $x$에 대한 항등식인 것은 ㄷ, ㄹ이다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0116",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 25,
  "num": "0116",
  "unit": "공수1-1-02",
  "unitName": "다항식 › 나머지정리와 인수분해",
  "type": "항등식",
  "level": "하",
  "kind": "주관식",
  "body": "다음 등식이 $x$에 대한 항등식일 때, 상수 $a$, $b$, $c$의 값을 구하시오.\n$$ax^2-(b-7)x+c+3=0$$",
  "choices": [],
  "answer": "$a=0$, $b=7$, $c=-3$",
  "figure": null,
  "solution": "$a=0$, $b-7=0$, $c+3=0$이므로\n$a=0$, $b=7$, $c=-3$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0117",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 25,
  "num": "0117",
  "unit": "공수1-1-02",
  "unitName": "다항식 › 나머지정리와 인수분해",
  "type": "항등식",
  "level": "하",
  "kind": "주관식",
  "body": "다음 등식이 $x$에 대한 항등식일 때, 상수 $a$, $b$, $c$의 값을 구하시오.\n$$(a-1)x^2+(b+1)x+2+c=0$$",
  "choices": [],
  "answer": "$a=1$, $b=-1$, $c=-2$",
  "figure": null,
  "solution": "$a-1=0$, $b+1=0$, $2+c=0$이므로\n$a=1$, $b=-1$, $c=-2$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0118",
  "source": "시중교재",
