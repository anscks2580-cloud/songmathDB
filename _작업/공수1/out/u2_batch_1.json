 },
 {
  "id": "SSEN-공수1-0129",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 25,
  "num": "0129",
  "unit": "공수1-1-02",
  "unitName": "다항식 › 나머지정리와 인수분해",
  "type": "나머지 정리와 인수 정리",
  "level": "하",
  "kind": "주관식",
  "body": "다항식 $P(x)=x^3+6x^2-kx-1$을 $x+3$으로 나누었을 때의 나머지가 $11$일 때, 상수 $k$의 값을 구하시오.",
  "choices": [],
  "answer": "$-5$",
  "figure": null,
  "solution": "$P(-3)=11$이므로 $-27+54+3k-1=11$\n$3k=-15$ $\\quad\\therefore\\ k=-5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0130",
