  "kind": "주관식",
  "body": "다음 식을 인수분해하시오.\n$$a(x-y)-b(y-x)$$",
  "choices": [],
  "answer": "$(a+b)(x-y)$",
  "figure": null,
  "solution": "$a(x-y)-b(y-x)=a(x-y)+b(x-y)$\n$=(a+b)(x-y)$",
  "parent": ""
 },
 {
