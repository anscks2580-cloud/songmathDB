  "level": "하",
  "kind": "주관식",
  "body": "$a+b=3$, $ab=-10$일 때, $a^2+b^2$의 값을 구하시오.",
  "choices": [],
  "answer": "29",
  "figure": null,
  "solution": "$a^2+b^2=(a+b)^2-2ab=3^2-2\\cdot(-10)=29$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0023",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
