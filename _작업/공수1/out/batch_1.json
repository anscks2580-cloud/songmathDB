 },
 {
  "id": "SSEN-공수1-0024",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0024",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$a+b=2$, $ab=-7$일 때, $(a-b)^2$의 값을 구하시오.",
  "choices": [],
  "answer": "32",
  "figure": null,
  "solution": "$(a-b)^2=(a+b)^2-4ab=2^2-4\\cdot(-7)=32$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0025",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0025",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$a+b=3$, $ab=-2$일 때, $a^3+b^3$의 값을 구하시오.",
  "choices": [],
  "answer": "45",
  "figure": null,
  "solution": "$a^3+b^3=(a+b)^3-3ab(a+b)$\n$=3^3-3\\cdot(-2)\\cdot 3=45$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0026",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0026",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$a-b=1$, $ab=4$일 때, $a^3-b^3$의 값을 구하시오.",
  "choices": [],
  "answer": "13",
  "figure": null,
  "solution": "$a^3-b^3=(a-b)^3+3ab(a-b)$\n$=1^3+3\\cdot 4\\cdot 1=13$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0027",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0027",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$a+b+c=2$, $ab+bc+ca=-1$, $abc=-2$일 때, $a^2+b^2+c^2$의 값을 구하시오.",
  "choices": [],
  "answer": "6",
  "figure": null,
  "solution": "$a^2+b^2+c^2=(a+b+c)^2-2(ab+bc+ca)$\n$=2^2-2\\cdot(-1)=6$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0028",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0028",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$a+b+c=2$, $ab+bc+ca=-1$, $abc=-2$일 때, $a^3+b^3+c^3$의 값을 구하시오.",
  "choices": [],
  "answer": "8",
  "figure": null,
  "solution": "0027에서 $a^2+b^2+c^2=6$이므로\n$a^3+b^3+c^3=(a+b+c)(a^2+b^2+c^2-ab-bc-ca)+3abc$\n$=2\\cdot\\{6-(-1)\\}+3\\cdot(-2)$\n$=8$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0029",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0029",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$x+\\dfrac{1}{x}=5$일 때, $x^2+\\dfrac{1}{x^2}$의 값을 구하시오.",
  "choices": [],
  "answer": "23",
  "figure": null,
  "solution": "$x^2+\\dfrac{1}{x^2}=\\left(x+\\dfrac{1}{x}\\right)^2-2=5^2-2=23$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0030",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0030",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$x+\\dfrac{1}{x}=5$일 때, $x^3+\\dfrac{1}{x^3}$의 값을 구하시오.",
  "choices": [],
  "answer": "110",
  "figure": null,
  "solution": "$x^3+\\dfrac{1}{x^3}=\\left(x+\\dfrac{1}{x}\\right)^3-3\\left(x+\\dfrac{1}{x}\\right)=5^3-3\\cdot 5=110$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0031",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0031",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$x=1+\\sqrt{2}$, $y=1-\\sqrt{2}$일 때, $x^3+y^3$의 값을 구하시오.",
  "choices": [],
  "answer": "14",
  "figure": null,
  "solution": "$x+y=(1+\\sqrt{2})+(1-\\sqrt{2})=2$,\n$xy=(1+\\sqrt{2})(1-\\sqrt{2})=-1$이므로\n$x^3+y^3=(x+y)^3-3xy(x+y)$\n$=2^3-3\\cdot(-1)\\cdot 2=14$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0032",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0032",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "곱셈 공식의 변형",
  "level": "하",
  "kind": "주관식",
  "body": "$x=1+\\sqrt{2}$, $y=1-\\sqrt{2}$일 때, $x^3-y^3$의 값을 구하시오.",
  "choices": [],
  "answer": "$10\\sqrt{2}$",
  "figure": null,
  "solution": "$x-y=(1+\\sqrt{2})-(1-\\sqrt{2})=2\\sqrt{2}$,\n$xy=(1+\\sqrt{2})(1-\\sqrt{2})=-1$이므로\n$x^3-y^3=(x-y)^3+3xy(x-y)$\n$=(2\\sqrt{2})^3+3\\cdot(-1)\\cdot 2\\sqrt{2}=10\\sqrt{2}$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0033",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0033",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 나눗셈의 몫과 나머지를 구하시오.\n$(x^3-2x^2+5)\\div(x-3)$",
  "choices": [],
  "answer": "몫: $x^2+x+3$, 나머지: $14$",
  "figure": null,
  "solution": "$$\\begin{array}{r}x^2+x+3\\\\x-3\\overline{)\\,x^3-2x^2\\phantom{+0x}+5}\\\\\\underline{x^3-3x^2\\phantom{+0x+5}}\\\\x^2\\phantom{+0x+5}\\\\\\underline{x^2-3x\\phantom{+5}}\\\\3x+5\\\\\\underline{3x-9}\\\\14\\end{array}$$\n$\\therefore$ 몫: $x^2+x+3$, 나머지: $14$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0034",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0034",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 나눗셈의 몫과 나머지를 구하시오.\n$(4x^3+5x^2-3x-1)\\div(x^2+2x-3)$",
  "choices": [],
  "answer": "몫: $4x-3$, 나머지: $15x-10$",
  "figure": null,
  "solution": "$$\\begin{array}{r}4x-3\\\\x^2+2x-3\\overline{)\\,4x^3+5x^2-3x-1}\\\\\\underline{4x^3+8x^2-12x\\phantom{-1}}\\\\-3x^2+9x-1\\\\\\underline{-3x^2-6x+9}\\\\15x-10\\end{array}$$\n$\\therefore$ 몫: $4x-3$, 나머지: $15x-10$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0035",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0035",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 나눗셈의 몫과 나머지를 구하시오.\n$(x^4-4x^3-7x^2+22x+24)\\div(x^2-x-6)$",
  "choices": [],
  "answer": "몫: $x^2-3x-4$, 나머지: $0$",
  "figure": null,
  "solution": "$$\\begin{array}{r}x^2-3x-4\\\\x^2-x-6\\overline{)\\,x^4-4x^3-7x^2+22x+24}\\\\\\underline{x^4-x^3-6x^2\\phantom{+22x+24}}\\\\-3x^3-x^2+22x\\phantom{+24}\\\\\\underline{-3x^3+3x^2+18x\\phantom{+24}}\\\\-4x^2+4x+24\\\\\\underline{-4x^2+4x+24}\\\\0\\end{array}$$\n$\\therefore$ 몫: $x^2-3x-4$, 나머지: $0$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0036",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0036",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 두 다항식 $A$, $B$에 대하여 $A$를 $B$로 나누었을 때의 몫을 $Q$, 나머지를 $R$라 할 때, $A=BQ+R$ 꼴로 나타내시오.\n$A=2x^3+x^2-7x+7$, $B=2x-1$",
  "choices": [],
  "answer": "$2x^3+x^2-7x+7=(2x-1)(x^2+x-3)+4$",
  "figure": null,
  "solution": "$$\\begin{array}{r}x^2+x-3\\\\2x-1\\overline{)\\,2x^3+x^2-7x+7}\\\\\\underline{2x^3-x^2\\phantom{-7x+7}}\\\\2x^2-7x\\phantom{+7}\\\\\\underline{2x^2-x\\phantom{+7}}\\\\-6x+7\\\\\\underline{-6x+3}\\\\4\\end{array}$$\n$\\therefore\\ 2x^3+x^2-7x+7=(2x-1)(x^2+x-3)+4$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0037",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0037",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 두 다항식 $A$, $B$에 대하여 $A$를 $B$로 나누었을 때의 몫을 $Q$, 나머지를 $R$라 할 때, $A=BQ+R$ 꼴로 나타내시오.\n$A=3x^3-x^2+4x+3$, $B=x^2+2$",
  "choices": [],
  "answer": "$3x^3-x^2+4x+3=(x^2+2)(3x-1)-2x+5$",
  "figure": null,
  "solution": "$$\\begin{array}{r}3x-1\\\\x^2+2\\overline{)\\,3x^3-x^2+4x+3}\\\\\\underline{3x^3\\phantom{-x^2}+6x\\phantom{+3}}\\\\-x^2-2x+3\\\\\\underline{-x^2\\phantom{-2x}-2}\\\\-2x+5\\end{array}$$\n$\\therefore\\ 3x^3-x^2+4x+3=(x^2+2)(3x-1)-2x+5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0038",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0038",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 조건을 만족시키는 다항식 $P(x)$를 구하시오.\n다항식 $P(x)$를 $x^2-5$로 나누었을 때의 몫이 $x+2$, 나머지가 $-3$이다.",
  "choices": [],
  "answer": "$x^3+2x^2-5x-13$",
  "figure": null,
  "solution": "$P(x)=(x^2-5)(x+2)-3$\n$=x^3+2x^2-5x-10-3$\n$=x^3+2x^2-5x-13$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0039",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 11,
  "num": "0039",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 나눗셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음 조건을 만족시키는 다항식 $P(x)$를 구하시오.\n다항식 $P(x)$를 $x^2-x+1$로 나누었을 때의 몫이 $x-1$, 나머지가 $-2x+4$이다.",
  "choices": [],
  "answer": "$x^3-2x^2+3$",
  "figure": null,
  "solution": "$P(x)=(x^2-x+1)(x-1)-2x+4$\n$=x^3-x^2-x^2+x+x-1-2x+4$\n$=x^3-2x^2+3$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0040",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 12,
  "num": "0040",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "중",
  "kind": "객관식",
  "body": "두 다항식 $A=2x^2-4xy+6y^2$, $B=-x^2+2xy+4y^2$에 대하여 $2X-B=A-5B$를 만족시키는 다항식 $X$는?",
  "choices": [
   "$-3x^2-6xy+5y^2$",
   "$-3x^2+6xy-5y^2$",
   "$3x^2-6xy-5y^2$",
   "$3x^2-6xy+5y^2$",
   "$3x^2+6xy+5y^2$"
  ],
  "answer": "③",
  "figure": null,
  "solution": "$2X-B=A-5B$에서\n$2X=A-4B$\n$\\therefore\\ X=\\dfrac{1}{2}A-2B$\n$=\\dfrac{1}{2}(2x^2-4xy+6y^2)-2(-x^2+2xy+4y^2)$\n$=x^2-2xy+3y^2+2x^2-4xy-8y^2$\n$=3x^2-6xy-5y^2$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0041",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 12,
  "num": "0041",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "객관식",
  "body": "세 다항식\n$A=2x^3-x^2+3x+4$, $B=x^3+x-2$,\n$C=-x^3+3x^2+5x-1$\n에 대하여 $A-2(A-B)+C$를 계산하면?",
  "choices": [
   "$-x^3-4x^2-4x+9$",
   "$-x^3-4x^2+4x+9$",
   "$-x^3+4x^2+4x-9$",
   "$x^3-2x^2-4x+9$",
   "$x^3+2x^2-4x-9$"
  ],
  "answer": "③",
  "figure": null,
  "solution": "$A-2(A-B)+C$\n$=-A+2B+C$\n$=-(2x^3-x^2+3x+4)+2(x^3+x-2)$\n$\\quad+(-x^3+3x^2+5x-1)$\n$=-2x^3+x^2-3x-4+2x^3+2x-4-x^3+3x^2+5x-1$\n$=-x^3+4x^2+4x-9$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0042",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 12,
  "num": "0042",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "중",
  "kind": "객관식",
  "body": "두 다항식 $A$, $B$에 대하여 $A*B=3A-B$라 할 때, $(x^2+2x-y+1)*(2x-y-5)$를 계산하면?",
  "choices": [
   "$x^2-4x+2y-8$",
   "$x^2+2x-2y+8$",
   "$3x^2-2x+2y-8$",
   "$3x^2+4x-2y+8$",
   "$3x^2+4x+2y-8$"
  ],
  "answer": "④",
  "figure": null,
  "solution": "$(x^2+2x-y+1)*(2x-y-5)$\n$=3(x^2+2x-y+1)-(2x-y-5)$\n$=3x^2+6x-3y+3-2x+y+5$\n$=3x^2+4x-2y+8$",
