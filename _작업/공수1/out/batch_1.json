 },
 {
  "id": "SSEN-공수1-0008",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 9,
  "num": "0008",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "주관식",
  "body": "세 다항식 $A=x^3-3x^2+x-1$, $B=2x^3+x^2-5$, $C=-x^2-4x+6$에 대하여 다음을 계산하시오.\n$A+B-C$",
  "choices": [],
  "answer": "$3x^3-x^2+5x-12$",
  "figure": null,
  "solution": "$A+B-C$\n$=(x^3-3x^2+x-1)+(2x^3+x^2-5)-(-x^2-4x+6)$\n$=x^3-3x^2+x-1+2x^3+x^2-5+x^2+4x-6$\n$=3x^3-x^2+5x-12$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0009",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 9,
  "num": "0009",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "주관식",
  "body": "세 다항식 $A=x^3-3x^2+x-1$, $B=2x^3+x^2-5$, $C=-x^2-4x+6$에 대하여 다음을 계산하시오.\n$3A-(2B+C)$",
  "choices": [],
  "answer": "$-x^3-10x^2+7x+1$",
  "figure": null,
  "solution": "$3A-(2B+C)$\n$=3A-2B-C$\n$=3(x^3-3x^2+x-1)-2(2x^3+x^2-5)-(-x^2-4x+6)$\n$=3x^3-9x^2+3x-3-4x^3-2x^2+10+x^2+4x-6$\n$=-x^3-10x^2+7x+1$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0010",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 9,
  "num": "0010",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "주관식",
  "body": "세 다항식 $A=x^3-3x^2+x-1$, $B=2x^3+x^2-5$, $C=-x^2-4x+6$에 대하여 다음을 계산하시오.\n$(A+2B)-(2A-C)$",
  "choices": [],
  "answer": "$3x^3+4x^2-5x-3$",
  "figure": null,
  "solution": "$(A+2B)-(2A-C)$\n$=A+2B-2A+C$ (주어진 식을 간단히 정리한 후 대입한다.)\n$=-A+2B+C$\n$=-(x^3-3x^2+x-1)+2(2x^3+x^2-5)+(-x^2-4x+6)$\n$=-x^3+3x^2-x+1+4x^3+2x^2-10-x^2-4x+6$\n$=3x^3+4x^2-5x-3$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0011",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 9,
  "num": "0011",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음을 만족시키는 두 다항식 $A$, $B$를 구하시오.\n$A+B=x^2-4x+3$, $A-B=x^2+2x-1$",
  "choices": [],
  "answer": "$A=x^2-x+1$, $B=-3x+2$",
  "figure": null,
  "solution": "$A+B=x^2-4x+3$ ⋯⋯ ㉠\n$A-B=x^2+2x-1$ ⋯⋯ ㉡\n㉠+㉡을 하면 $2A=2x^2-2x+2$\n$\\therefore\\ A=x^2-x+1$\n이것을 ㉠에 대입하면 $(x^2-x+1)+B=x^2-4x+3$\n$\\therefore\\ B=(x^2-4x+3)-(x^2-x+1)$\n$=x^2-4x+3-x^2+x-1=-3x+2$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0012",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 9,
  "num": "0012",
  "unit": "공수1-1-01",
  "unitName": "다항식 › 다항식의 연산",
  "type": "다항식의 덧셈과 뺄셈",
  "level": "하",
  "kind": "주관식",
  "body": "다음을 만족시키는 두 다항식 $A$, $B$를 구하시오.\n$A+B=x^2+2x+5$, $2A-B=5x^2-11x-2$",
  "choices": [],
  "answer": "$A=2x^2-3x+1$, $B=-x^2+5x+4$",
  "figure": null,
  "solution": "$A+B=x^2+2x+5$ ⋯⋯ ㉠\n$2A-B=5x^2-11x-2$ ⋯⋯ ㉡\n㉠+㉡을 하면 $3A=6x^2-9x+3$\n$\\therefore\\ A=2x^2-3x+1$\n이것을 ㉠에 대입하면 $(2x^2-3x+1)+B=x^2+2x+5$\n$\\therefore\\ B=(x^2+2x+5)-(2x^2-3x+1)$\n$=x^2+2x+5-2x^2+3x-1$\n$=-x^2+5x+4$",
  "parent": ""
 },
