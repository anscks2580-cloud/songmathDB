  "choicesFigure": null,
  "solution": "$(3+i)^2=9+6i+i^2$\n$=9+6i-1$\n$=8+6i$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0307",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 49,
  "num": "0307",
  "unit": "공수1-2-03",
  "unitName": "방정식 › 복소수",
  "type": "복소수의 사칙연산",
  "level": "하",
  "kind": "주관식",
  "body": "$\\dfrac{1-i}{1+i}$를 $a+bi$ ($a$, $b$는 실수) 꼴로 나타내시오.",
  "choices": [],
  "answer": "$-i$",
  "figure": null,
  "choicesFigure": null,
  "solution": "$\\dfrac{1-i}{1+i}=\\dfrac{(1-i)^2}{(1+i)(1-i)}=\\dfrac{1-2i+i^2}{1-i^2}$\n$=\\dfrac{1-2i-1}{1+1}=\\dfrac{-2i}{2}=-i$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0308",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 49,
  "num": "0308",
  "unit": "공수1-2-03",
  "unitName": "방정식 › 복소수",
  "type": "복소수의 사칙연산",
  "level": "하",
  "kind": "주관식",
  "body": "$\\dfrac{3+2i}{2-i}$를 $a+bi$ ($a$, $b$는 실수) 꼴로 나타내시오.",
  "choices": [],
  "answer": "$\\dfrac{4}{5}+\\dfrac{7}{5}i$",
  "figure": null,
  "choicesFigure": null,
  "solution": "$\\dfrac{3+2i}{2-i}=\\dfrac{(3+2i)(2+i)}{(2-i)(2+i)}=\\dfrac{6+3i+4i+2i^2}{4-i^2}$\n$=\\dfrac{6+7i-2}{4+1}=\\dfrac{4+7i}{5}$\n$=\\dfrac{4}{5}+\\dfrac{7}{5}i$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0309",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
