  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "인수분해를 이용하여 이차방정식 $x^2-x-20=0$을 푸시오.",
  "choices": [],
  "answer": "$x=-4$ 또는 $x=5$",
  "figure": null,
  "solution": "$x^2-x-20=0$에서 $(x+4)(x-5)=0$\n$\\therefore\\ x=-4$ 또는 $x=5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0408",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0408",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "인수분해를 이용하여 이차방정식 $9x^2-6x+1=0$을 푸시오.",
  "choices": [],
  "answer": "$x=\\dfrac13$",
  "figure": null,
  "solution": "$9x^2-6x+1=0$에서 $(3x-1)^2=0$\n$\\therefore\\ x=\\dfrac13$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0409",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0409",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "인수분해를 이용하여 이차방정식 $5x^2-9x-2=0$을 푸시오.",
  "choices": [],
  "answer": "$x=-\\dfrac15$ 또는 $x=2$",
  "figure": null,
  "solution": "$5x^2-9x-2=0$에서 $(5x+1)(x-2)=0$\n$\\therefore\\ x=-\\dfrac15$ 또는 $x=2$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0410",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0410",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "인수분해를 이용하여 이차방정식 $x^2-\\dfrac12x-\\dfrac12=0$을 푸시오.",
  "choices": [],
  "answer": "$x=-\\dfrac12$ 또는 $x=1$",
  "figure": null,
  "solution": "$x^2-\\dfrac12x-\\dfrac12=0$의 양변에 $2$를 곱하면\n$2x^2-x-1=0,\\qquad (2x+1)(x-1)=0$\n$\\therefore\\ x=-\\dfrac12$ 또는 $x=1$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0411",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0411",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "근의 공식을 이용하여 이차방정식 $x^2-3x-1=0$을 푸시오.",
  "choices": [],
  "answer": "$x=\\dfrac{3\\pm\\sqrt{13}}{2}$",
  "figure": null,
  "solution": "$$x=\\dfrac{-(-3)\\pm\\sqrt{(-3)^2-4\\cdot1\\cdot(-1)}}{2\\cdot1}=\\dfrac{3\\pm\\sqrt{13}}{2}$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0412",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0412",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "근의 공식을 이용하여 이차방정식 $2x^2+5x+4=0$을 푸시오.",
  "choices": [],
  "answer": "$x=\\dfrac{-5\\pm\\sqrt{7}i}{4}$",
  "figure": null,
  "solution": "$$x=\\dfrac{-5\\pm\\sqrt{5^2-4\\cdot2\\cdot4}}{2\\cdot2}=\\dfrac{-5\\pm\\sqrt{-7}}{4}=\\dfrac{-5\\pm\\sqrt{7}i}{4}$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0413",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0413",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "근의 공식을 이용하여 이차방정식 $3x^2-2\\sqrt{10}x+3=0$을 푸시오.",
  "choices": [],
  "answer": "$x=\\dfrac{\\sqrt{10}\\pm1}{3}$",
  "figure": null,
  "solution": "$3x^2-2\\cdot\\sqrt{10}x+3=0$이므로\n$$x=\\dfrac{-(-\\sqrt{10})\\pm\\sqrt{(-\\sqrt{10})^2-3\\cdot3}}{3}=\\dfrac{\\sqrt{10}\\pm1}{3}$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0414",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0414",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "근의 공식을 이용하여 이차방정식 $9x^2+6x+5=0$을 푸시오.",
  "choices": [],
  "answer": "$x=\\dfrac{-1\\pm2i}{3}$",
  "figure": null,
  "solution": "$9x^2+2\\cdot3x+5=0$이므로\n$$x=\\dfrac{-3\\pm\\sqrt{3^2-9\\cdot5}}{9}=\\dfrac{-3\\pm\\sqrt{-36}}{9}=\\dfrac{-3\\pm6i}{9}=\\dfrac{-1\\pm2i}{3}$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0415",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0415",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $2x^2-5x+2=0$을 풀고, 그 근이 실근인지 허근인지 말하시오.",
  "choices": [],
  "answer": "$x=\\dfrac12$ 또는 $x=2$, 실근",
  "figure": null,
  "solution": "$2x^2-5x+2=0$에서 $(2x-1)(x-2)=0$\n$\\therefore\\ x=\\dfrac12$ 또는 $x=2$\n따라서 주어진 이차방정식의 근은 실근이다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0416",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0416",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $16x^2-24x+9=0$을 풀고, 그 근이 실근인지 허근인지 말하시오.",
  "choices": [],
  "answer": "$x=\\dfrac34$, 실근",
  "figure": null,
  "solution": "$16x^2-24x+9=0$에서 $(4x-3)^2=0$\n$\\therefore\\ x=\\dfrac34$\n따라서 주어진 이차방정식의 근은 실근이다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0417",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0417",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+4=0$을 풀고, 그 근이 실근인지 허근인지 말하시오.",
  "choices": [],
  "answer": "$x=\\pm2i$, 허근",
  "figure": null,
  "solution": "$x^2+4=0$에서 $x^2=-4$\n$\\therefore\\ x=\\pm\\sqrt{-4}=\\pm2i$\n따라서 주어진 이차방정식의 근은 허근이다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0418",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0418",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 풀이",
  "stdType": "이차방정식의 풀이",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $4x^2-2x+1=0$을 풀고, 그 근이 실근인지 허근인지 말하시오.",
  "choices": [],
  "answer": "$x=\\dfrac{1\\pm\\sqrt{3}i}{4}$, 허근",
  "figure": null,
  "solution": "$$x=\\dfrac{-(-1)\\pm\\sqrt{(-1)^2-4\\cdot1}}{4}=\\dfrac{1\\pm\\sqrt{-3}}{4}=\\dfrac{1\\pm\\sqrt{3}i}{4}$$\n따라서 주어진 이차방정식의 근은 허근이다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0419",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0419",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $7x^2+3x-1=0$의 근을 판별하시오.",
  "choices": [],
  "answer": "서로 다른 두 실근",
  "figure": null,
  "solution": "주어진 이차방정식의 판별식을 $D$라 하면\n$$D=3^2-4\\cdot7\\cdot(-1)=37>0$$\n따라서 서로 다른 두 실근을 갖는다.\n참고 이차방정식 $7x^2+3x-1=0$에서 $x^2$의 계수 $7$과 상수항 $-1$의 부호가 다르므로 이 방정식은 서로 다른 두 실근을 갖는다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0420",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0420",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $4x^2-12x+9=0$의 근을 판별하시오.",
  "choices": [],
  "answer": "중근",
  "figure": null,
  "solution": "$4x^2-2\\cdot6x+9=0$이므로 이 이차방정식의 판별식을 $D$라 하면\n$$\\dfrac D4=(-6)^2-4\\cdot9=0$$\n따라서 중근을 갖는다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0421",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0421",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+2\\sqrt{3}x+5=0$의 근을 판별하시오.",
  "choices": [],
  "answer": "서로 다른 두 허근",
  "figure": null,
  "solution": "$x^2+2\\cdot\\sqrt{3}x+5=0$이므로 이 이차방정식의 판별식을 $D$라 하면\n$$\\dfrac D4=(\\sqrt{3})^2-1\\cdot5=-2<0$$\n따라서 서로 다른 두 허근을 갖는다.",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0422",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0422",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "다음 조건을 만족시키는 이차방정식인 것만을 보기에서 있는 대로 고르시오.\n\n> ㄱ. $x^2+5x+3=0$\n> ㄴ. $2x^2-3x+2=0$\n> ㄷ. $x^2+2x-6=0$\n> ㄹ. $4x^2-4x+1=0$\n> ㅁ. $2x^2+4x+3=0$\n> ㅂ. $2x^2+2x-1=0$\n\n(1) 서로 다른 두 실근을 갖는다.\n(2) 중근을 갖는다.\n(3) 서로 다른 두 허근을 갖는다.",
  "choices": [],
  "answer": "(1) ㄱ, ㄷ, ㅂ  (2) ㄹ  (3) ㄴ, ㅁ",
  "figure": null,
  "solution": "보기에 주어진 각 이차방정식의 판별식을 $D$라 하면\nㄱ. $D=5^2-4\\cdot1\\cdot3=13>0$\nㄴ. $D=(-3)^2-4\\cdot2\\cdot2=-7<0$\nㄷ. $\\dfrac D4=1^2-1\\cdot(-6)=7>0$\nㄹ. $\\dfrac D4=(-2)^2-4\\cdot1=0$\nㅁ. $\\dfrac D4=2^2-2\\cdot3=-2<0$\nㅂ. $\\dfrac D4=1^2-2\\cdot(-1)=3>0$\n(1) 서로 다른 두 실근을 가지려면 $D>0$이어야 하므로 ㄱ, ㄷ, ㅂ\n(2) 중근을 가지려면 $D=0$이어야 하므로 ㄹ\n(3) 서로 다른 두 허근을 가지려면 $D<0$이어야 하므로 ㄴ, ㅁ",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0423",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0423",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $2x^2-x-k=0$이 다음과 같은 근을 갖도록 하는 실수 $k$의 값 또는 $k$의 값의 범위를 구하시오.\n(1) 서로 다른 두 실근\n(2) 중근\n(3) 서로 다른 두 허근",
  "choices": [],
  "answer": "(1) $k>-\\dfrac18$  (2) $-\\dfrac18$  (3) $k<-\\dfrac18$",
  "figure": null,
  "solution": "이차방정식 $2x^2-x-k=0$의 판별식을 $D$라 하면\n$$D=(-1)^2-4\\cdot2\\cdot(-k)=1+8k$$\n(1) 서로 다른 두 실근을 가지려면 $D>0$이어야 하므로\n$$D=1+8k>0\\quad\\therefore\\ k>-\\dfrac18$$\n(2) 중근을 가지려면 $D=0$이어야 하므로\n$$D=1+8k=0\\quad\\therefore\\ k=-\\dfrac18$$\n(3) 서로 다른 두 허근을 가지려면 $D<0$이어야 하므로\n$$D=1+8k<0\\quad\\therefore\\ k<-\\dfrac18$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0424",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0424",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차식 $x^2+kx+7$이 완전제곱식이 되도록 하는 실수 $k$의 값을 모두 구하시오.",
  "choices": [],
  "answer": "$\\pm2\\sqrt{7}$",
  "figure": null,
  "solution": "주어진 이차식이 완전제곱식이 되려면 이차방정식 $x^2+kx+7=0$이 중근을 가져야 한다.\n이 이차방정식의 판별식을 $D$라 하면\n$$D=k^2-4\\cdot1\\cdot7=0,\\qquad k^2=28$$\n$\\therefore\\ k=\\pm2\\sqrt{7}$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0425",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 63,
  "num": "0425",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근의 판별",
  "stdType": "이차방정식의 근의 판별",
  "level": "하",
  "kind": "주관식",
  "body": "이차식 $x^2-(k+1)x+k+4$가 완전제곱식이 되도록 하는 실수 $k$의 값을 모두 구하시오.",
  "choices": [],
  "answer": "$-3$, $5$",
  "figure": null,
  "solution": "주어진 이차식이 완전제곱식이 되려면 이차방정식 $x^2-(k+1)x+k+4=0$이 중근을 가져야 한다.\n이 이차방정식의 판별식을 $D$라 하면\n$$D=\\{-(k+1)\\}^2-4\\cdot1\\cdot(k+4)=0$$\n$$k^2+2k+1-4k-16=0$$\n$$k^2-2k-15=0,\\qquad (k+3)(k-5)=0$$\n$\\therefore\\ k=-3$ 또는 $k=5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0426",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0426",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2-x+2=0$의 두 근을 $\\alpha$, $\\beta$라 할 때, 다음 식의 값을 구하시오.\n(1) $\\alpha+\\beta$\n(2) $\\alpha\\beta$\n(3) $\\alpha^2+\\beta^2$\n(4) $(\\alpha-1)(\\beta-1)$",
  "choices": [],
  "answer": "(1) $1$  (2) $2$  (3) $-3$  (4) $2$",
  "figure": null,
  "solution": "이차방정식 $x^2-x+2=0$에서 근과 계수의 관계에 의하여\n(1) $\\alpha+\\beta=-\\dfrac{-1}{1}=1$\n(2) $\\alpha\\beta=\\dfrac21=2$\n(3) $\\alpha^2+\\beta^2=(\\alpha+\\beta)^2-2\\alpha\\beta=1^2-2\\cdot2=-3$\n(4) $(\\alpha-1)(\\beta-1)=\\alpha\\beta-(\\alpha+\\beta)+1=2-1+1=2$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0427",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0427",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2-3x+1=0$의 두 근을 $\\alpha$, $\\beta$라 할 때, 다음 식의 값을 구하시오.\n(1) $\\alpha^2+\\alpha\\beta+\\beta^2$\n(2) $\\alpha^3\\beta+\\alpha\\beta^3$\n(3) $\\dfrac{\\beta}{\\alpha}+\\dfrac{\\alpha}{\\beta}$\n(4) $(\\alpha-\\beta)^2$",
  "choices": [],
  "answer": "(1) $8$  (2) $7$  (3) $7$  (4) $5$",
  "figure": null,
  "solution": "이차방정식 $x^2-3x+1=0$에서 근과 계수의 관계에 의하여\n$$\\alpha+\\beta=-\\dfrac{-3}{1}=3,\\ \\alpha\\beta=\\dfrac11=1$$\n(1) $\\alpha^2+\\alpha\\beta+\\beta^2=(\\alpha+\\beta)^2-\\alpha\\beta=3^2-1=8$\n(2) $\\alpha^3\\beta+\\alpha\\beta^3=\\alpha\\beta(\\alpha^2+\\beta^2)=\\alpha\\beta\\{(\\alpha+\\beta)^2-2\\alpha\\beta\\}=1\\cdot(3^2-2\\cdot1)=7$\n(3) $\\dfrac{\\beta}{\\alpha}+\\dfrac{\\alpha}{\\beta}=\\dfrac{\\alpha^2+\\beta^2}{\\alpha\\beta}=\\dfrac{(\\alpha+\\beta)^2-2\\alpha\\beta}{\\alpha\\beta}=\\dfrac{3^2-2\\cdot1}{1}=7$\n(4) $(\\alpha-\\beta)^2=(\\alpha+\\beta)^2-4\\alpha\\beta=3^2-4\\cdot1=5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0428",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0428",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $ax^2+bx+c=0$의 두 근이 $-2$, $4$일 때, 이차방정식 $cx^2+ax+b=0$에 대하여 다음을 구하시오. (단, $a$, $b$, $c$는 상수이다.)\n(1) 두 근의 합\n(2) 두 근의 곱",
  "choices": [],
  "answer": "(1) $\\dfrac18$  (2) $\\dfrac14$",
  "figure": null,
  "solution": "이차방정식 $ax^2+bx+c=0$의 두 근이 $-2$, $4$이므로 이 이차방정식의 근과 계수의 관계에 의하여\n$$-2+4=-\\dfrac ba,\\ -2\\cdot4=\\dfrac ca$$\n$\\therefore\\ b=-2a,\\ c=-8a$\n따라서 이차방정식 $cx^2+ax+b=0$, 즉 $-8ax^2+ax-2a=0$에서 $a\\ne0$이므로 이차방정식의 근과 계수의 관계에 의하여\n(1) 두 근의 합은 $-\\dfrac{a}{-8a}=\\dfrac18$\n(2) 두 근의 곱은 $\\dfrac{-2a}{-8a}=\\dfrac14$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0429",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0429",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "두 수 $-4$, $3$을 근으로 하고 $x^2$의 계수가 $1$인 이차방정식을 구하시오.",
  "choices": [],
  "answer": "$x^2+x-12=0$",
  "figure": null,
  "solution": "$x^2-(-4+3)x+(-4)\\cdot3=0$\n$\\therefore\\ x^2+x-12=0$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0430",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0430",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "두 수 $3+\\sqrt{2}$, $3-\\sqrt{2}$를 근으로 하고 $x^2$의 계수가 $1$인 이차방정식을 구하시오.",
  "choices": [],
  "answer": "$x^2-6x+7=0$",
  "figure": null,
  "solution": "$x^2-\\{(3+\\sqrt{2})+(3-\\sqrt{2})\\}x+(3+\\sqrt{2})(3-\\sqrt{2})=0$\n$\\therefore\\ x^2-6x+7=0$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0431",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0431",
