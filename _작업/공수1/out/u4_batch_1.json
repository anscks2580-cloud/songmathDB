  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "두 수 $2+i$, $2-i$를 근으로 하고 $x^2$의 계수가 $1$인 이차방정식을 구하시오.",
  "choices": [],
  "answer": "$x^2-4x+5=0$",
  "figure": null,
  "solution": "$x^2-\\{(2+i)+(2-i)\\}x+(2+i)(2-i)=0$\n$\\therefore\\ x^2-4x+5=0$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0432",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0432",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "두 수 $-\\dfrac13$, $1$을 근으로 하고 $x^2$의 계수가 $3$인 이차방정식을 구하시오.",
  "choices": [],
  "answer": "$3x^2-2x-1=0$",
  "figure": null,
  "solution": "$3\\left\\{x^2-\\left(-\\dfrac13+1\\right)x+\\left(-\\dfrac13\\right)\\cdot1\\right\\}=0$\n$3\\left(x^2-\\dfrac23x-\\dfrac13\\right)=0\\quad\\therefore\\ 3x^2-2x-1=0$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0433",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0433",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "$\\alpha+\\beta=2$, $\\alpha\\beta=-7$을 만족시키는 두 수 $\\alpha$, $\\beta$를 구하시오. (단, $\\alpha<\\beta$)",
  "choices": [],
  "answer": "$\\alpha=1-2\\sqrt{2}$, $\\beta=1+2\\sqrt{2}$",
  "figure": null,
  "solution": "두 수 $\\alpha$, $\\beta$를 근으로 하고 $x^2$의 계수가 $1$인 이차방정식은\n$$x^2-2x-7=0$$\n$$\\therefore\\ x=-(-1)\\pm\\sqrt{(-1)^2-1\\cdot(-7)}=1\\pm\\sqrt{8}=1\\pm2\\sqrt{2}$$\n이때 $\\alpha<\\beta$이므로 $\\alpha=1-2\\sqrt{2},\\ \\beta=1+2\\sqrt{2}$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0434",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0434",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 근과 계수의 관계",
  "stdType": "이차방정식의 근과 계수의 관계",
  "level": "하",
  "kind": "주관식",
  "body": "$\\alpha+\\beta=-3$, $\\alpha\\beta=-1$을 만족시키는 두 수 $\\alpha$, $\\beta$를 구하시오. (단, $\\alpha<\\beta$)",
  "choices": [],
  "answer": "$\\alpha=\\dfrac{-3-\\sqrt{13}}{2}$, $\\beta=\\dfrac{-3+\\sqrt{13}}{2}$",
  "figure": null,
  "solution": "두 수 $\\alpha$, $\\beta$를 근으로 하고 $x^2$의 계수가 $1$인 이차방정식은\n$$x^2+3x-1=0$$\n$$\\therefore\\ x=\\dfrac{-3\\pm\\sqrt{3^2-4\\cdot1\\cdot(-1)}}{2}=\\dfrac{-3\\pm\\sqrt{13}}{2}$$\n이때 $\\alpha<\\beta$이므로 $\\alpha=\\dfrac{-3-\\sqrt{13}}{2},\\ \\beta=\\dfrac{-3+\\sqrt{13}}{2}$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0435",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0435",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차식의 인수분해",
  "stdType": "이차식의 인수분해",
  "level": "하",
  "kind": "주관식",
  "body": "이차식 $x^2+x-4$를 복소수의 범위에서 인수분해하시오.",
  "choices": [],
  "answer": "$\\left(x+\\dfrac{1-\\sqrt{17}}{2}\\right)\\left(x+\\dfrac{1+\\sqrt{17}}{2}\\right)$",
  "figure": null,
  "solution": "$x^2+x-4=0$에서\n$$x=\\dfrac{-1\\pm\\sqrt{1^2-4\\cdot1\\cdot(-4)}}{2}=\\dfrac{-1\\pm\\sqrt{17}}{2}$$\n$$\\therefore\\ x^2+x-4=\\left(x-\\dfrac{-1+\\sqrt{17}}{2}\\right)\\left(x-\\dfrac{-1-\\sqrt{17}}{2}\\right)=\\left(x+\\dfrac{1-\\sqrt{17}}{2}\\right)\\left(x+\\dfrac{1+\\sqrt{17}}{2}\\right)$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0436",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0436",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차식의 인수분해",
  "stdType": "이차식의 인수분해",
  "level": "하",
  "kind": "주관식",
  "body": "이차식 $x^2+25$를 복소수의 범위에서 인수분해하시오.",
  "choices": [],
  "answer": "$(x+5i)(x-5i)$",
  "figure": null,
  "solution": "$x^2+25=0$에서 $x^2=-25\\quad\\therefore\\ x=\\pm5i$\n$\\therefore\\ x^2+25=(x+5i)(x-5i)$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0437",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0437",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차식의 인수분해",
  "stdType": "이차식의 인수분해",
  "level": "하",
  "kind": "주관식",
  "body": "이차식 $3x^2-2x+2$를 복소수의 범위에서 인수분해하시오.",
  "choices": [],
  "answer": "$3\\left(x-\\dfrac{1+\\sqrt{5}i}{3}\\right)\\left(x-\\dfrac{1-\\sqrt{5}i}{3}\\right)$",
  "figure": null,
  "solution": "$3x^2-2x+2=0$에서\n$$x=\\dfrac{-(-1)\\pm\\sqrt{(-1)^2-3\\cdot2}}{3}=\\dfrac{1\\pm\\sqrt{-5}}{3}=\\dfrac{1\\pm\\sqrt{5}i}{3}$$\n$$\\therefore\\ 3x^2-2x+2=3\\left(x-\\dfrac{1+\\sqrt{5}i}{3}\\right)\\left(x-\\dfrac{1-\\sqrt{5}i}{3}\\right)$$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0438",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0438",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 켤레근",
  "stdType": "이차방정식의 켤레근",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+ax+b=0$의 한 근이 $2-\\sqrt{3}$일 때, 유리수 $a$, $b$의 값을 구하시오.",
  "choices": [],
  "answer": "$a=-4$, $b=1$",
  "figure": null,
  "solution": "주어진 이차방정식의 계수가 유리수이므로 $2-\\sqrt{3}$이 근이면 $2+\\sqrt{3}$도 근이다.\n따라서 이차방정식의 근과 계수의 관계에 의하여\n$$(2-\\sqrt{3})+(2+\\sqrt{3})=-a,\\ (2-\\sqrt{3})(2+\\sqrt{3})=b$$\n$\\therefore\\ a=-4,\\ b=1$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0439",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0439",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 켤레근",
  "stdType": "이차방정식의 켤레근",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+ax+b=0$의 한 근이 $-5+3\\sqrt{2}$일 때, 유리수 $a$, $b$의 값을 구하시오.",
  "choices": [],
  "answer": "$a=10$, $b=7$",
  "figure": null,
  "solution": "주어진 이차방정식의 계수가 유리수이므로 $-5+3\\sqrt{2}$가 근이면 $-5-3\\sqrt{2}$도 근이다.\n따라서 이차방정식의 근과 계수의 관계에 의하여\n$$(-5+3\\sqrt{2})+(-5-3\\sqrt{2})=-a,$$\n$$(-5+3\\sqrt{2})(-5-3\\sqrt{2})=b$$\n$\\therefore\\ a=10,\\ b=7$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0440",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0440",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 켤레근",
  "stdType": "이차방정식의 켤레근",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+ax+b=0$의 한 근이 $1-2i$일 때, 실수 $a$, $b$의 값을 구하시오.",
  "choices": [],
  "answer": "$a=-2$, $b=5$",
  "figure": null,
  "solution": "주어진 이차방정식의 계수가 실수이므로 $1-2i$가 근이면 $1+2i$도 근이다.\n따라서 이차방정식의 근과 계수의 관계에 의하여\n$$(1-2i)+(1+2i)=-a,\\ (1-2i)(1+2i)=b$$\n$\\therefore\\ a=-2,\\ b=5$",
  "parent": ""
 },
 {
  "id": "SSEN-공수1-0441",
  "source": "시중교재",
  "book": "쎈 공통수학1 (22개정)",
  "page": 65,
  "num": "0441",
  "unit": "공수1-2-04",
  "unitName": "방정식 › 이차방정식",
  "type": "이차방정식의 켤레근",
  "stdType": "이차방정식의 켤레근",
  "level": "하",
  "kind": "주관식",
  "body": "이차방정식 $x^2+ax+b=0$의 한 근이 $3+4i$일 때, 실수 $a$, $b$의 값을 구하시오.",
  "choices": [],
  "answer": "$a=-6$, $b=25$",
  "figure": null,
  "solution": "주어진 이차방정식의 계수가 실수이므로 $3+4i$가 근이면 $3-4i$도 근이다.\n따라서 이차방정식의 근과 계수의 관계에 의하여\n$$(3+4i)+(3-4i)=-a,\\ (3+4i)(3-4i)=b$$\n$\\therefore\\ a=-6,\\ b=25$",
  "parent": ""
 },
 {
